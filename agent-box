#!/bin/bash
# ro-bind each $PATH dir under $HOME (r-x only), plus the targets of symlinks inside
# them (e.g. ~/.local/bin/claude -> ~/.local/share/claude/versions/X). Nothing else of ~.
# ponytail: one level of symlinks; a target in a */bin dir binds its prefix (venv/app dir).
binds=()
declare -A seen
add() { [[ -e $1 && ! ${seen[$1]} ]] && seen[$1]=1 && binds+=(--ro-bind "$1" "$1"); }

# toolchain data the shims need (ro). Add here when a tool breaks in the box.
for t in ~/.rustup ~/.juliaup ~/.julia "$(go env GOROOT 2>/dev/null)"; do
  [[ $t == "$HOME"/* ]] && add "$t"
done

IFS=: read -ra dirs <<< "$PATH"
for d in "${dirs[@]}"; do
  [[ $d == "$HOME"/* && -d $d ]] || continue
  add "$d"
  for f in "$d"/*; do
    [[ -L $f ]] || continue
    t=$(realpath -q "$f") || continue
    [[ $t == "$HOME"/* && $t != "$d"/* ]] || continue
    [[ $(basename "$(dirname "$t")") == bin ]] && t=$(dirname "$(dirname "$t")")
    add "$t"
  done
done

# rw dirs from the config (~/.clankerjail). Lines before any [section] are always bound;
# `-n NAME` adds only [NAME], no -n adds every section. `path:ro` binds read-only.
# `-p NAME` uses the profile ~/.clankerjail.NAME instead (a separate sandbox, own top lines).
conf=${CLANKERJAIL:-~/.clankerjail}
ns=
while [[ ${1:-} == -[np] ]]; do
  [[ $1 == -n ]] && ns=$2 || conf=~/.clankerjail.$2
  shift 2
done
[[ -f $conf ]] || { echo "agent-box: missing $conf (see README)" >&2; exit 1; }
cbinds=() ents=() sec= found=
while read -r line; do
  [[ -z $line || $line == \#* ]] && continue
  if [[ $line =~ ^\[(.+)\]$ ]]; then
    sec=${BASH_REMATCH[1]}; [[ $sec == "$ns" ]] && found=1; continue
  fi
  [[ -z $sec || -z $ns || $sec == "$ns" ]] || continue
  p=${line/#\~/$HOME} mode=--bind
  [[ $p == *:ro ]] && { p=${p%:ro}; mode=--ro-bind; }
  ents+=("$p"$'\t'"$mode")
done < "$conf"
[[ -z $ns || $found ]] || { echo "agent-box: no [$ns] in $conf" >&2; exit 1; }
# later binds mount over earlier ones: sort so a parent always precedes its children
# (~/phd before ~/phd/data:ro), whatever the order in the file.
while IFS=$'\t' read -r p mode; do
  [[ $p ]] && cbinds+=("$mode" "$p" "$p")
done < <(printf '%s\n' "${ents[@]}" | sort -s -t$'\t' -k1,1)

# claude can't self-update inside (its install dir is ro), so update on the host first.
[[ $(basename "${1:-}") == claude ]] && { "$1" update || true; }

exec bwrap \
  --ro-bind / / \
  --dev /dev \
  --proc /proc \
  --unshare-pid \
  --unshare-ipc \
  --die-with-parent \
  --tmpfs /tmp \
  --tmpfs ~ \
  "${binds[@]}" \
  "${cbinds[@]}" \
  --ro-bind "$(realpath "$0")" "$(realpath "$0")" \
  --ro-bind-try ~/.claude/settings.json ~/.claude/settings.json \
  --ro-bind-try ~/.claude/hooks ~/.claude/hooks \
  --ro-bind-try ~/.claude/plugins ~/.claude/plugins \
  --setenv AGENT_BOX 1 \
  "$@"
